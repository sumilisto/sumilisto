# ==============================================================================
# SUMILISTO - VARIABLES DE ENTORNO (.env.example)
# Copia este archivo a .env.local para desarrollo local
# En producción, configura estas variables en el panel de Vercel (Project Settings > Environment Variables)
# ==============================================================================

# ENTORNO Y URLs
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
USE_MOCK_DATA=true # Cambiar a false cuando las credenciales reales de Google Sheets y Supabase estén configuradas

# DATOS DEL NEGOCIO (VALORES POR DEFECTO SI SUPABASE ESTÁ EN MODO FALLBACK)
NEXT_PUBLIC_STORE_NAME="Sumilisto"
NEXT_PUBLIC_STORE_PHONE="584227894547"
NEXT_PUBLIC_STORE_ZONES="Caracas, Guarenas, Guatire"

# GOOGLE SHEETS API (SOLO LECTURA)
# Cuenta de servicio de Google Cloud Console (IAM)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=""
GOOGLE_SHEET_INVENTORY_ID=

# SUPABASE (BASE DE DATOS POSTGRESQL + AUTH CON 2FA)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY= # NUNCA exponer al cliente

# SEGURIDAD Y ACCESO ADMINISTRATIVO
ADMIN_EMAILS=
ADMIN_SESSION_SECRET=

# CLOUDFLARE TURNSTILE (CAPTCHA INVISIBLE EN /admin/login)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# RATE LIMITING & ANTI-ABUSO (UPSTASH REDIS)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# CLOUDINARY (FOTOS Y OPTIMIZACIÓN WEBP/AVIF)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# META MARKETING & CONVERSIONS API (CAPI)
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
